{
    "manifest_version": 2,
    "minimum_chrome_version": "91",

    "name": "Endcord Web",
    "description": "Endcord for Discord in your browser: plugins, themes and a settings panel right inside Discord.",
    "author": "rootpoii",
    "homepage_url": "https://endcord.com",
    "icons": {
        "128": "icon.png"
    },

    "permissions": [
        "webRequest",
        "webRequestBlocking",
        "*://*.discord.com/*",
        "https://raw.githubusercontent.com/*"
    ],

    "content_scripts": [
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["content.js"],
            "all_frames": true,
            "world": "ISOLATED"
        },
        {
            "run_at": "document_start",
            "matches": ["*://*.discord.com/*"],
            "js": ["dist/Endcord.js"],
            "all_frames": true,
            "world": "MAIN"
        }
    ],

    "background": {
        "scripts": ["background.js"]
    },

    "web_accessible_resources": ["dist/Endcord.js", "dist/Endcord.css"],

    "browser_specific_settings": {
        "gecko": {
            "id": "endcord-web@endcord.com",
            "strict_min_version": "128.0"
        }
    }
}
